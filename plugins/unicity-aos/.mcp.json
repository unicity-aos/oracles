{
  "mcpServers": {
    "aos": {
      "command": "/bin/sh",
      "args": [
        "./bin/aos-up",
        "--principal",
        "codex-code"
      ],
      "cwd": ".",
      "startup_timeout_sec": 20,
      "env_vars": [
        "AOS_HOME",
        "AOS_BIN",
        "AOS_BIN_ROOT",
        "ASTRID_SESSION_ID",
        "ASTRID_WORKSPACE"
      ],
      "env": {}
    }
  }
}
