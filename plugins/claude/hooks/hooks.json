{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/aos-mcp-start\" --hook",
            "timeout": 5,
            "statusMessage": "Checking Unicity AOS setup status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/aos-up hook session_start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/aos-native-hook\" claude user_prompt_submit",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/aos-native-hook\" claude pre_tool_use", "timeout": 15}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/aos-up hook session_end", "timeout": 15}]}]
  }
}
