{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${GROK_PLUGIN_ROOT}\"/bin/aos-up grok ready --format hook",
            "timeout": 15,
            "statusMessage": "Checking Unicity AOS readiness"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\"/bin/aos-up grok session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${GROK_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}\"/bin/aos-up hook user_prompt_submit",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
