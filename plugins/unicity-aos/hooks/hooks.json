{
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex interrupt",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex permission_request",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex post_compact",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex post_tool_use",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex pre_compact",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex pre_tool_use",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex session_end",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-codex-mcp\" --hook",
            "timeout": 5,
            "statusMessage": "Checking AOS setup status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex session_start",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex subagent_start",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex subagent_stop",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-.}}/bin/aos-native-hook\" codex user_prompt_submit",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
