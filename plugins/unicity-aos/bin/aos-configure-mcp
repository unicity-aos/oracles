#!/usr/bin/env python3
"""Bind the legacy Codex MCP command to this installed plugin, not ambient env."""
import argparse
import json
from pathlib import Path


def configure(plugin, aos=None, installed_root=None):
    config_path = plugin / ".mcp.json"
    config = json.loads(config_path.read_text())
    server = config["mcpServers"]["aos"]
    server["command"] = "python3"
    server["args"] = [str((installed_root or plugin) / "bin/aos-mcp-start"), "--principal", "codex-code"]
    # Preserve the host session's cwd; it identifies the actual project.
    server.pop("cwd", None)
    if aos is not None:
        server.setdefault("env", {})["AOS_BIN"] = aos
    config_path.write_text(json.dumps(config, indent=2) + "\n")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--aos")
    parser.add_argument("--installed-root", type=Path)
    args = parser.parse_args()
    configure(Path(__file__).resolve().parent.parent, args.aos, args.installed_root)
