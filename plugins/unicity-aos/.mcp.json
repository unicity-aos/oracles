{
  "mcpServers": {
    "aos": {
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/bin/aos-codex-mcp",
        "--principal",
        "codex-code"
      ],
      "startup_timeout_sec": 20,
      "env_vars": [
        "AOS_HOME",
        "AOS_BIN",
        "AOS_BIN_ROOT",
        "ASTRID_SESSION_ID",
        "ASTRID_WORKSPACE",
        "AOS_HOST_WORKSPACE",
        "CODEX_WORKSPACE"
      ],
      "env": {}
    }
  }
}
